# Copie este arquivo para .env.local e preencha.
# .env.local NÃO vai para o git.

# Google Analytics 4 — ID da propriedade, formato G-XXXXXXXXXX.
# Enquanto estiver vazio/ausente, o site não carrega nada do Google.
# O valor é embutido no HTML durante o `npm run build` (site estático).
NEXT_PUBLIC_GA_ID=
